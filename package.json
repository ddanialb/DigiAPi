{
  "name": "digiapi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:css && vite build",
    "preview": "vite preview",
    "tailwind": "npx @tailwindcss/cli -i ./src/css/main.css -o ./src/css/output.css --watch",
    "build:css": "tailwindcss -i ./src/css/main.css -o ./src/css/output.css --minify"
  },
  "devDependencies": {
    "tailwindcss": "^4.1.18",
    "vite": "^7.2.4",
    "@tailwindcss/cli": "^4.1.18"
  },
  "dependencies": {
    "swiper": "^12.1.3"
  }
}
